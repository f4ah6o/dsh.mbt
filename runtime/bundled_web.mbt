///|
/// Built browser assets embedded in every `dsh` executable.
/// Regenerate with `sh scripts/generate-bundled-web.sh` after building web assets.
fn native_embedded_web_asset(path : String) -> String? {
  match path {
    "/index.html" => Some(native_embedded_web_index_html())
    "/moonbit/browser.js" => Some(native_embedded_web_browser_js())
    "/kumo-standalone.css" => Some(native_embedded_web_kumo_standalone_css())
    "/yami-kumo-components.css" =>
      Some(native_embedded_web_yami_kumo_components_css())
    "/yami-kumo-shell.css" => Some(native_embedded_web_yami_kumo_shell_css())
    "/manifest.webmanifest" => Some(native_embedded_web_manifest_webmanifest())
    "/icon.svg" => Some(native_embedded_web_icon_svg())
    "/sw.js" => Some(native_embedded_web_sw_js())
    _ => None
  }
}

///|
/// Embedded source for `web/index.html`.
fn native_embedded_web_index_html() -> String {
  let encoded = [
    "",
    "",
    "Ij48L2Rpdj4KICA8L2JvZHk+CjwvaHRtbD4K",
  ].join("")
  @utf8.decode_lossy(@base64.decode_lossy(encoded))
}

