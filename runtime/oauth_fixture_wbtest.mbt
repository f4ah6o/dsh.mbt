///|
const NATIVE_OAUTH_FIXTURE_STATE : String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNO"

///|
const NATIVE_OAUTH_FIXTURE_NONCE : String = "abcdefghijklmnopqrstuv"

///|
const NATIVE_OAUTH_FIXTURE_JWKS_URL : String = "http://127.0.0.1:43127/jwks"

///|
fn native_fixture_endpoints() -> AuthEndpoints {
  {
    authorize: "http://127.0.0.1:43127/authorize",
    token: "http://127.0.0.1:43127/token",
    discovery: "http://127.0.0.1:43127/.well-known/openid-configuration",
    models: "http://127.0.0.1:43127/models",
    test_mode: true,
  }
}

///|
fn native_fixture_jwk() -> Json {
  Json::object({
    "kid": "fixture-kid-1".to_json(),
    "kty": "RSA".to_json(),
    "alg": "RS256".to_json(),
    "use": "sig".to_json(),
    "n": NATIVE_OAUTH_FIXTURE_MODULUS.to_json(),
    "e": "AQAB".to_json(),
  })
}

///|
fn native_fixture_transport(
  endpoints : AuthEndpoints,
  token_calls : Array[String],
  rotate_jwks_once : Bool,
  endpoint : String,
  kind : String,
  headers : @http.Headers,
) -> Result[(Int, Json), String] {
  ignore(headers)
  token_calls.push(kind)
  if kind == "discovery" && endpoint == endpoints.discovery {
    return Ok(
      (
        200,
        Json::object({
          "issuer": "https://auth.openai.com".to_json(),
          "jwks_uri": NATIVE_OAUTH_FIXTURE_JWKS_URL.to_json(),
        }),
      ),
    )
  }
  if kind == "jwks" && endpoint == NATIVE_OAUTH_FIXTURE_JWKS_URL {
    let mut key_reads = 0
    for requested_kind in token_calls {
      if requested_kind == "jwks" {
        key_reads += 1
      }
    }
    if rotate_jwks_once && key_reads == 1 {
      return Ok(
        (
          200,
          Json::object({
            "keys": Json::array([
              Json::object({
                "kid": "previous-key".to_json(),
                "kty": "RSA".to_json(),
              }),
            ]),
          }),
        ),
      )
    }
    return Ok(
      (200, Json::object({ "keys": Json::array([native_fixture_jwk()]) })),
    )
  }
  Err("fixture transport received an unexpected endpoint")
}

///|
async fn native_verify_fixture_token(
  token : String,
  rotate_jwks_once : Bool,
  token_calls : Array[String],
) -> Result[Json, String] {
  let endpoints = native_fixture_endpoints()
  native_verify_id_token_with(endpoints, token, fn(endpoint, kind, headers) {
    native_fixture_transport(
      endpoints, token_calls, rotate_jwks_once, endpoint, kind, headers,
    )
  })
}

///|
fn native_fixture_attempt() -> @auth.LoginAttempt raise {
  match
    @auth.LoginAttempt::new(
      "urn:uuid:00000000-0000-4000-8000-000000000001",
      "http://127.0.0.1:43127/auth/callback",
      None,
      None,
      None,
      None,
      NATIVE_OAUTH_FIXTURE_STATE,
      NATIVE_OAUTH_FIXTURE_NONCE,
      "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_",
      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"[:43].to_owned(),
    ) {
    Ok(attempt) => attempt
    Err(error) => fail(error)
  }
}

///|
fn native_fixture_returning_attempt() -> @auth.LoginAttempt raise {
  match
    @auth.LoginAttempt::new(
      "urn:uuid:00000000-0000-4000-8000-000000000001",
      "http://127.0.0.1:43127/auth/callback",
      Some("registered-client"),
      None,
      None,
      None,
      NATIVE_OAUTH_FIXTURE_STATE,
      NATIVE_OAUTH_FIXTURE_NONCE,
      "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_",
      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"[:43].to_owned(),
    ) {
    Ok(attempt) => attempt
    Err(error) => fail(error)
  }
}

///|
fn native_fixture_callback(
  attempt : @auth.LoginAttempt,
) -> @auth.OAuthCallback raise {
  match
    attempt.validate_callback({
      "state": NATIVE_OAUTH_FIXTURE_STATE,
      "code": "fixture-authorization-code",
      "client_id": "registered-client",
    }) {
    Ok(callback) => callback
    Err(error) => fail(error)
  }
}

///|
fn native_fixture_token_response(id_token : String) -> Json {
  Json::object({
    "token_type": "Bearer".to_json(),
    "access_token": "synthetic-access-token".to_json(),
    "refresh_token": "synthetic-refresh-token".to_json(),
    "id_token": id_token.to_json(),
    "expires_in": Json::number(3600.0),
    "scope": @auth.REQUESTED_SCOPES.to_json(),
  })
}

///|
async test "native OAuth verifies RS256 through discovery and retries one JWKS rotation" {
  let calls : Array[String] = []
  let claims = match
    native_verify_fixture_token(NATIVE_OAUTH_FIXTURE_VALID, true, calls) {
    Ok(value) => value
    Err(error) => fail(error)
  }
  assert_eq(calls, ["discovery", "jwks", "jwks"])
  assert_eq(
    native_auth_string(native_object_field(claims, "iss")),
    "https://auth.openai.com",
  )
  assert_eq(
    native_auth_string(native_object_field(claims, "sub")),
    "acct_fixture",
  )
  let attempt = native_fixture_returning_attempt()
  let credential = match
    @auth.accept_token_response(
      attempt,
      native_fixture_callback(attempt),
      native_fixture_token_response(NATIVE_OAUTH_FIXTURE_VALID),
      claims,
      true,
      2000,
    ) {
    Ok(value) => value
    Err(error) => fail(error)
  }
  assert_true(credential.can_use_direct())
  assert_true(
    !credential.public_summary().stringify().contains("synthetic-access-token"),
  )
}

///|
test "native RS256 primitive verifies the checked-in public signature fixture" {
  let modulus = match
    native_base64url_decode(NATIVE_OAUTH_FIXTURE_MODULUS, limit=8192) {
    Ok(value) => value
    Err(error) => fail(error)
  }
  let exponent = match native_base64url_decode("AQAB", limit=32) {
    Ok(value) => value
    Err(error) => fail(error)
  }
  let (header, rest) = match NATIVE_OAUTH_FIXTURE_VALID.split_once(".") {
    Some(value) => value
    None => fail("fixture token is malformed")
  }
  let (payload, signature_part) = match rest.split_once(".") {
    Some(value) => value
    None => fail("fixture token is malformed")
  }
  let signature = match
    native_base64url_decode(signature_part.to_owned(), limit=2048) {
    Ok(value) => value
    Err(error) => fail(error)
  }
  assert_true(
    SafeRoot::verify_rs256(
      modulus,
      exponent,
      @utf8.encode(header.to_owned() + "." + payload.to_owned()),
      signature,
    ),
  )
}

///|
async test "native OAuth rejects signed wrong issuer and tampered RSA signature" {
  let wrong_issuer_calls : Array[String] = []
  assert_true(
    native_verify_fixture_token(
      NATIVE_OAUTH_FIXTURE_WRONG_ISSUER,
      false,
      wrong_issuer_calls,
    )
    is Err(_),
  )
  assert_true(wrong_issuer_calls.is_empty())
  let tampered_calls : Array[String] = []
  assert_true(
    native_verify_fixture_token(
      NATIVE_OAUTH_FIXTURE_VALID + "x",
      false,
      tampered_calls,
    )
    is Err(_),
  )
  assert_eq(tampered_calls, ["discovery", "jwks"])
}

///|
async test "native verified claims still reject wrong audience nonce and expiry" {
  let cases = [
    (NATIVE_OAUTH_FIXTURE_WRONG_AUDIENCE, 2000),
    (NATIVE_OAUTH_FIXTURE_WRONG_NONCE, 2000),
    (NATIVE_OAUTH_FIXTURE_EXPIRED, 2000),
  ]
  for (token, now) in cases {
    let calls : Array[String] = []
    let claims = match native_verify_fixture_token(token, false, calls) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    let attempt = native_fixture_attempt()
    assert_true(
      @auth.accept_token_response(
        attempt,
        native_fixture_callback(attempt),
        native_fixture_token_response(token),
        claims,
        true,
        now,
      )
      is Err(_),
    )
  }
}

///|
async test "model catalog refresh clears removed selection and fences old effects" {
  let fixture = @fs.tmpdir(prefix="dsh-native-model-removal")
  @async.with_task_group() <| group => {
    group.add_defer(() => @fs.rmdir(fixture, recursive=true))
    let data_dir = fixture + "/data"
    @fs.mkdir(data_dir, permission=0o700)
    let store = match NativeStore::open(data_dir) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => ignore(store.close()))
    let auth = match NativeAuth::open(store) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => auth.close())
    let credential = match
      @auth.Credential::from_storage_json({
        "version": 1,
        "host_id": store.host_id(),
        "client_id": "fixture-client",
        "subject": "fixture-account",
        "email": "user@example.test",
        "profile_id": "fixture-account",
        "id_token": "synthetic-id-token",
        "access_token": "synthetic-access-token",
        "refresh_token": "synthetic-refresh-token",
        "scopes": Json::array([
          "openid".to_json(),
          "profile".to_json(),
          "email".to_json(),
          "offline_access".to_json(),
          "resource.invoke".to_json(),
          "chatgpt.tokens.use.direct".to_json(),
        ]),
        "expires_at": (native_auth_now() + 7200).to_json(),
      }) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    auth.credential = Some(credential)
    auth.generation = "fixture-model-generation"
    auth.selected_model = Some("removed-model")
    auth.model_identity = Some(credential.identity_for_native())
    auth.models = [{ "slug": "removed-model", "display_name": "Removed model" }]
    auth.login_state = "connected"
    assert_true(auth.persist_locked() is Ok(_))
    let stale_selection = match auth.provider_selection() {
      Ok(value) => value
      Err(error) => fail(error)
    }
    let fetch_count = Ref(0)
    let refreshed = match
      auth.models_with(async fn(endpoints, token) {
        @async.sleep(0)
        ignore(endpoints)
        assert_eq(token, "synthetic-access-token")
        fetch_count.val += 1
        Ok([
          { "slug": "replacement-model", "display_name": "Replacement model" },
        ])
      }) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    assert_eq(fetch_count.val, 1)
    assert_true(object_field(refreshed, "selected_model") is Some(Json::Null))
    assert_eq(auth.selected_model, None)
    assert_true(auth.generation != stale_selection.generation)
    assert_true(auth.validate_generation(stale_selection) is Err(_))
    assert_eq(auth.visible_models().length(), 1)
    let stored = match native_auth_load(auth.root, auth.host_id) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    assert_eq(stored.selected_model, None)
    assert_eq(stored.model_identity, Some(credential.identity_for_native()))
    assert_eq(
      native_auth_string(object_field(stored.models[0], "slug")),
      "replacement-model",
    )
  }
}

///|
async test "rotated refresh survives failed save and stale sign-in rollback" {
  let fixture = @fs.tmpdir(prefix="dsh-native-refresh-rotation")
  @async.with_task_group() <| group => {
    group.add_defer(() => @fs.rmdir(fixture, recursive=true))
    let data_dir = fixture + "/data"
    @fs.mkdir(data_dir, permission=0o700)
    let store = match NativeStore::open(data_dir) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => ignore(store.close()))
    let auth = match NativeAuth::open(store) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => auth.close())
    let credential = match
      @auth.Credential::from_storage_json({
        "version": 1,
        "host_id": store.host_id(),
        "client_id": "fixture-client",
        "subject": "fixture-account",
        "email": "user@example.test",
        "profile_id": "fixture-account",
        "id_token": "synthetic-id-token",
        "access_token": "synthetic-access-token",
        "refresh_token": "synthetic-refresh-token",
        "scopes": Json::array([
          "openid".to_json(),
          "profile".to_json(),
          "email".to_json(),
          "offline_access".to_json(),
          "resource.invoke".to_json(),
          "chatgpt.tokens.use.direct".to_json(),
        ]),
        "expires_at": (native_auth_now() + 30).to_json(),
      }) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    auth.credential = Some(credential)
    auth.generation = "fixture-refresh-generation"
    auth.selected_model = Some("fixture-model")
    auth.model_identity = Some(credential.identity_for_native())
    auth.models = [{ "slug": "fixture-model", "display_name": "Fixture" }]
    auth.login_state = "connected"
    assert_true(auth.persist_locked() is Ok(_))
    let selection = match auth.provider_selection() {
      Ok(value) => value
      Err(error) => fail(error)
    }

    let refresh_forms : Array[String] = []
    let failed_save = auth.refresh_locked_with(
      credential,
      native_auth_now(),
      fn(endpoints, endpoint, form) {
        ignore(endpoints)
        ignore(endpoint)
        refresh_forms.push(form)
        Ok(
          (
            200,
            Json::object({
              "token_type": "Bearer".to_json(),
              "access_token": "rotated-access-fixture".to_json(),
              "refresh_token": "rotated-refresh-fixture".to_json(),
              "expires_in": Json::number(3600.0),
            }),
          ),
        )
      },
      fn() { Err("fixture persistence failure") },
    )
    assert_true(failed_save is Err(error) && error.contains("AUTH_STORE_ERROR"))
    assert_true(auth.pending_checkpoint)
    let retained = match auth.credential {
      Some(value) => value
      None => fail("rotated credential was discarded after persistence failure")
    }
    assert_eq(
      native_auth_string(object_field(retained.storage_json(), "refresh_token")),
      "rotated-refresh-fixture",
    )
    assert_eq(refresh_forms.length(), 1)
    assert_true(refresh_forms[0].contains("synthetic-refresh-token"))

    let blocked_use = auth.credential_for_selection_with(selection, fn() {
      Err("fixture persistence failure")
    })
    assert_true(blocked_use is Err(error) && error.contains("AUTH_STORE_ERROR"))
    assert_eq(refresh_forms.length(), 1)

    let replacement = match
      @auth.Credential::from_storage_json({
        "version": 1,
        "host_id": store.host_id(),
        "client_id": "fixture-client",
        "subject": "replacement-account",
        "email": "replacement@example.test",
        "profile_id": "replacement-account",
        "id_token": "synthetic-replacement-id-token",
        "access_token": "synthetic-replacement-access-token",
        "refresh_token": "synthetic-replacement-refresh-token",
        "scopes": Json::array([
          "openid".to_json(),
          "profile".to_json(),
          "email".to_json(),
          "offline_access".to_json(),
          "resource.invoke".to_json(),
          "chatgpt.tokens.use.direct".to_json(),
        ]),
        "expires_at": (native_auth_now() + 7200).to_json(),
      }) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    let failed_sign_in_save = auth.commit_sign_in_with(
      replacement,
      selection.generation,
      fn() { Err("fixture sign-in checkpoint failure") },
    )
    assert_true(
      failed_sign_in_save is Err(error) &&
      error.contains("fixture sign-in checkpoint failure"),
    )
    let after_failed_sign_in = auth.credential.unwrap()
    assert_eq(
      native_auth_string(
        object_field(after_failed_sign_in.storage_json(), "refresh_token"),
      ),
      "rotated-refresh-fixture",
    )
    assert_eq(auth.generation, selection.generation)
    assert_eq(auth.selected_model, Some("fixture-model"))
    assert_eq(auth.model_identity, Some(credential.identity_for_native()))
    assert_eq(
      native_auth_string(object_field(auth.models[0], "slug")),
      "fixture-model",
    )
    assert_true(auth.pending_checkpoint)

    let credential_ready = match auth.credential_for_selection(selection) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    assert_eq(
      credential_ready.access_token_for_transport(),
      "rotated-access-fixture",
    )
    assert_true(!auth.pending_checkpoint)
    assert_eq(refresh_forms.length(), 1)
    let persisted = match native_auth_load(auth.root, auth.host_id) {
      Ok(value) => value.credential.unwrap()
      Err(error) => fail(error)
    }
    assert_eq(
      native_auth_string(
        object_field(persisted.storage_json(), "refresh_token"),
      ),
      "rotated-refresh-fixture",
    )
  }
}

///|
test "native callback parser rejects injection and callback validation binds state and client" {
  assert_true(
    native_parse_callback_query("/auth/callback?state=one&state=two") is Err(_),
  )
  assert_true(native_parse_callback_query("/auth/callback?state=%GG") is Err(_))
  let attempt = native_fixture_returning_attempt()
  assert_true(
    attempt.validate_callback({
      "state": "wrong-state",
      "code": "code",
      "client_id": "registered-client",
    })
    is Err(_),
  )
  assert_true(
    attempt.validate_callback({
      "state": NATIVE_OAUTH_FIXTURE_STATE,
      "code": "code",
      "client_id": "different-client",
    })
    is Err(_),
  )
  assert_true(native_parse_callback_query("/auth/callback?state=one") is Ok(_))
}

///|
async test "native callback deadline covers accepted sockets with incomplete headers" {
  let address = @socket.Addr::parse("127.0.0.1:0") catch {
    _ => fail("could not parse callback test address")
  }
  let server = @http.Server::Server(address, reuse_addr=false)
  let server_address = server.addr
  let request_sent = Ref(false)
  @async.with_task_group() <| group => {
    let client = group.spawn(async fn() {
      let connection = @socket.Tcp::connect(server_address)
      defer connection.close()
      connection.write(
        "GET /auth/callback?state=fixture HTTP/1.1\r\nHost: localhost\r\n",
      )
      request_sent.val = true
      @async.sleep(150)
    })
    while !request_sent.val {
      @async.sleep(1)
    }
    match native_wait_for_callback_timeout(server, 50) {
      Err(error) => assert_true(error.contains("AUTH_TIMEOUT"))
      Ok(_) => fail("incomplete callback headers were accepted")
    }
    client.wait()
  }
}

///|
async fn native_auth_serve_json_once(
  server : @http.Server,
  body : String,
  delay_ms : Int,
) -> Unit {
  try {
    let (connection, _) = server.accept()
    defer connection.close()
    ignore(connection.read_request())
    connection.skip_request_body()
    connection.send_response(200, "OK", extra_headers={
      "Content-Type": "application/json",
      "Content-Length": body.length().to_string(),
      "Connection": "close",
    })
    if delay_ms > 0 {
      @async.sleep(delay_ms)
    }
    connection.write_string(body)
    connection.end_response()
  } catch {
    _ => ()
  }
}

///|
async test "OAuth GET deadline and body limit cover streamed responses" {
  let address = @socket.Addr::parse("127.0.0.1:0") catch {
    _ => fail("could not parse OAuth HTTP fixture address")
  }
  let server = @http.Server::Server(address, reuse_addr=false)
  let endpoint = "http://127.0.0.1:\{server.addr.port()}/discovery"
  let endpoints = {
    authorize: endpoint,
    token: endpoint,
    discovery: endpoint,
    models: endpoint,
    test_mode: true,
  }
  @async.with_task_group() <| group => {
    let delayed = group.spawn(async fn() {
      native_auth_serve_json_once(server, "{\"issuer\":\"fixture\"}", 200)
    })
    let timed_out = oauth_get_json(
      endpoints,
      endpoint,
      "discovery",
      timeout_ms=50,
    )
    match timed_out {
      Err(error) if error.contains("AUTH_TIMEOUT") => ()
      Err(error) => fail("expected AUTH_TIMEOUT, got " + error)
      Ok(_) => fail("incomplete OAuth response was accepted")
    }
    delayed.wait()
  }
  server.close()

  let second_address = @socket.Addr::parse("127.0.0.1:0") catch {
    _ => fail("could not parse OAuth HTTP fixture address")
  }
  let second_server = @http.Server::Server(second_address, reuse_addr=false)
  let second_endpoint = "http://127.0.0.1:\{second_server.addr.port()}/large-model-list"
  let second_endpoints = {
    authorize: second_endpoint,
    token: second_endpoint,
    discovery: second_endpoint,
    models: second_endpoint,
    test_mode: true,
  }
  @async.with_task_group() <| group => {
    let oversized = group.spawn(async fn() {
      native_auth_serve_json_once(
        second_server,
        "x".repeat(NATIVE_AUTH_RESPONSE_BYTE_LIMIT + 1),
        0,
      )
    })
    let response = oauth_get_json(
      second_endpoints,
      second_endpoint,
      "models",
      // The full native package test runs many local HTTP fixtures in parallel.
      // Keep the body limit assertion independent of scheduler load; the
      // separate timeout case above still checks the deadline path at 50 ms.
      timeout_ms=5000,
    )
    match response {
      Err(error) if error.contains("AUTH_RESPONSE_TOO_LARGE") => ()
      Err(error) => fail("expected AUTH_RESPONSE_TOO_LARGE, got " + error)
      Ok((status, _)) =>
        fail(
          "expected AUTH_RESPONSE_TOO_LARGE, got accepted HTTP status " +
          status.to_string(),
        )
    }
    oversized.wait()
  }
  second_server.close()
}

///|
async test "OAuth token POST deadline includes response body streaming" {
  let address = @socket.Addr::parse("127.0.0.1:0") catch {
    _ => fail("could not parse OAuth HTTP fixture address")
  }
  let server = @http.Server::Server(address, reuse_addr=false)
  let endpoint = "http://127.0.0.1:\{server.addr.port()}/token"
  let endpoints = {
    authorize: endpoint,
    token: endpoint,
    discovery: endpoint,
    models: endpoint,
    test_mode: true,
  }
  @async.with_task_group() <| group => {
    let delayed = group.spawn(async fn() {
      native_auth_serve_json_once(server, "{\"access_token\":\"fixture\"}", 200)
    })
    let timed_out = oauth_post_form(
      endpoints,
      endpoint,
      "grant_type=refresh_token",
      timeout_ms=50,
    )
    assert_true(timed_out is Err(error) && error.contains("AUTH_TIMEOUT"))
    delayed.wait()
  }
  server.close()
}

///|
fn native_object_field(value : Json, name : String) -> Json? {
  match value {
    Object(fields) => fields.get(name)
    _ => None
  }
}

///|
async test "browser sign-in handoff never exposes the stored ID token hint" {
  let fixture = @fs.tmpdir(prefix="dsh-native-browser-handoff")
  @async.with_task_group() <| group => {
    group.add_defer(() => @fs.rmdir(fixture, recursive=true))
    let data_dir = fixture + "/data"
    @fs.mkdir(data_dir, permission=0o700)
    let store = match NativeStore::open(data_dir) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => ignore(store.close()))
    let auth = match NativeAuth::open(store) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => auth.close())
    let credential = match
      @auth.Credential::from_storage_json({
        "version": 1,
        "host_id": store.host_id(),
        "client_id": "fixture-client",
        "subject": "fixture-account",
        "email": "user@example.test",
        "profile_id": "fixture-account",
        "id_token": "synthetic-id-token",
        "access_token": "synthetic-access-token",
        "refresh_token": "synthetic-refresh-token",
        "scopes": Json::array([
          "openid".to_json(),
          "profile".to_json(),
          "email".to_json(),
          "offline_access".to_json(),
          "resource.invoke".to_json(),
          "chatgpt.tokens.use.direct".to_json(),
        ]),
        "expires_at": (native_auth_now() + 7200).to_json(),
      }) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    auth.credential = Some(credential)
    auth.generation = "fixture-browser-handoff-generation"
    auth.model_identity = Some(credential.identity_for_native())
    auth.login_state = "connected"
    let prepared = match auth.prepare_sign_in_attempt(false) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    assert_true(!prepared.authorization_url.contains("id_token_hint"))
    assert_true(!prepared.authorization_url.contains("synthetic-id-token"))
    prepared.server.close()
  }
}

///|
async test "duplicate browser sign-in returns promptly and cancellation closes callback" {
  let fixture = @fs.tmpdir(prefix="dsh-native-browser-duplicate")
  @async.with_task_group() <| group => {
    group.add_defer(() => @fs.rmdir(fixture, recursive=true))
    let data_dir = fixture + "/data"
    @fs.mkdir(data_dir, permission=0o700)
    let store = match NativeStore::open(data_dir) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => ignore(store.close()))
    let auth = match NativeAuth::open(store) {
      Ok(value) => value
      Err(error) => fail(error)
    }
    group.add_defer(() => auth.close())
    let prepared = match auth.prepare_browser_sign_in() {
      Ok(Some(value)) => value
      Ok(None) => fail("first browser sign-in did not start")
      Err(error) => fail(error)
    }
    let finisher = group.spawn(async fn() {
      ignore(auth.finish_browser_sign_in(prepared)) catch {
        _ => ()
      }
    })
    @async.sleep(0)
    let duplicate = auth.prepare_browser_sign_in()
    assert_true(duplicate is Ok(None))
    finisher.cancel()
    ignore(finisher.wait()) catch {
      _ => ()
    }
    assert_true(auth.pending_browser_sign_in_server is None)
    assert_eq(auth.login_state, "signed_out")
  }
}
