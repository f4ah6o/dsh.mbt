{
  "name": "@f4ah6o/dsh.mbt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure MoonBit agent runtime, native CLI/service, and compiled browser UI.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify:env": "node scripts/verify-env.mjs",
    "build": "sh scripts/build.sh",
    "build:shell": "node scripts/build-web-shell.mjs",
    "check": "node scripts/check.mjs && node scripts/build-web-shell.mjs --check",
    "check:shell": "node scripts/build-web-shell.mjs --check",
    "test": "npm run check && npm run test:moon && npm run build && npm run test:web && npm run test:integration",
    "test:moon": "sh scripts/test-moon.sh",
    "test:web": "node --test web/*.test.mjs",
    "test:integration": "sh scripts/test-browser-smoke.sh",
    "start": "moon run native --target native --release -- --serve",
    "demo": "moon run native --target native --release -- --demo",
    "mutation": "node scripts/mutation.mjs",
    "mutation:list": "node scripts/mutation.mjs --list"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
